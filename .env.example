# SGI Environment Configuration
# Copy this file to .env and fill in your actual values.
# On cloud platforms (Render, Railway, Heroku, Docker) set these as
# environment variables in the platform dashboard — do NOT commit .env.

# ── MongoDB ────────────────────────────────────────────────────────────────
# Option A: full Atlas / replica-set URI  (recommended)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<appName>

# Option B: separate host/port/db  (local or self-hosted MongoDB)
# MONGODB_HOST=localhost
# MONGODB_PORT=27017
# MONGODB_DB=sgi_db

# ── Cloudinary (file / photo uploads) ─────────────────────────────────────
# Leave blank to fall back to local uploads/ directory
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Resend (OTP and contact emails) ───────────────────────────────────────
# Get an API key from https://resend.com/api-keys. Never commit the real key.
RESEND_API_KEY=your-resend-api-key
# Must be a verified sender in Resend. If omitted, onboarding@resend.dev is used
# for Resend's limited test-sender behavior.
RESEND_FROM_EMAIL=noreply@yourdomain.com
# Existing destination for student/mentor contact form messages.
MAIL_USERNAME=support@yourdomain.com

# ── Application ────────────────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
