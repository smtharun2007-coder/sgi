<?php
// SGI runtime configuration.
// The tracked config.php entry point loads this file. All sensitive values
// are read from environment variables and must not be added to source control.

date_default_timezone_set('Asia/Kolkata');

if (session_status() === PHP_SESSION_NONE) {
    session_start();
}

require __DIR__ . '/vendor/autoload.php';

// Load .env if present (Render/Docker inject directly; local development uses .env)
if (file_exists(__DIR__ . '/.env')) {
    $envLines = file(__DIR__ . '/.env', FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
    foreach ($envLines as $line) {
        if (strpos($line, '=') === false || strpos($line, '#') === 0) continue;
        list($key, $value) = explode('=', $line, 2);
        $k = trim($key);
        $v = trim($value);
        if (strlen($v) >= 2 && (($v[0] === '"' && substr($v, -1) === '"') || ($v[0] === "'" && substr($v, -1) === "'"))) {
            $v = substr($v, 1, -1);
        }
        putenv("{$k}={$v}");
        $_ENV[$k] = $v;
        $_SERVER[$k] = $v;
    }
}

// MongoDB — supports MONGODB_URI (Atlas) or MONGODB_HOST/PORT/DB (self-hosted)
$mongoUri = getenv('MONGODB_URI');
if (empty($mongoUri)) {
    $mongoHost = getenv('MONGODB_HOST') ?: 'localhost';
    $mongoPort = getenv('MONGODB_PORT') ?: '27017';
    $mongoUri  = "mongodb://{$mongoHost}:{$mongoPort}";
}
$mongoDatabase = getenv('MONGODB_DB') ?: 'sgi_db';

$client = new MongoDB\Client($mongoUri);
$db = $client->selectDatabase($mongoDatabase);

$users           = $db->users;
$semesters       = $db->semesters;
$subjects        = $db->subjects;
$mentors         = $db->mentors;
$announcements   = $db->announcements;
$calendar_events = $db->calendar_events;

// SGINotificationCollection ensures that EVERY notification inserted anywhere in the app
// is also dispatched as an Android system push notification outside the app.
if (!class_exists('SGINotificationCollection')) {
    class SGINotificationCollection {
        private $collection;

        public function __construct($collection) {
            $this->collection = $collection;
        }

        public function insertOne($document, array $options = []) {
            $result = $this->collection->insertOne($document, $options);

            try {
                $docArray = (array)$document;
                $recipient = $docArray['roll'] ?? $docArray['student_id'] ?? $docArray['user_id'] ?? $docArray['mentor_id'] ?? null;
                $message = $docArray['message'] ?? '';
                $link = $docArray['link'] ?? 'dashboard.php';

                if ($recipient && !empty($message)) {
                    if (file_exists(__DIR__ . '/fcm_helper.php')) {
                        require_once __DIR__ . '/fcm_helper.php';
                        $title = !empty($docArray['mentor_id']) ? 'SGI Mentor Alert' : 'SGI Alert';
                        sendFcmNotificationToUser($recipient, $title, $message, $link);
                    }
                }
            } catch (\Throwable $e) {
                error_log("FCM Auto-Dispatch Error: " . $e->getMessage());
            }

            return $result;
        }

        public function __call($method, $args) {
            return call_user_func_array([$this->collection, $method], $args);
        }
    }
}

$notifications   = new SGINotificationCollection($db->notifications);
$approvals       = $db->approvals;

// LEAP collections
$leap_applications      = $db->leap_applications;
$leap_memberships       = $db->leap_memberships;
$leap_announcements     = $db->leap_announcements;
$leap_activities        = $db->leap_activities;
$leap_training          = $db->leap_training;
$leap_training_sessions = $db->leap_training_sessions;
$leap_attendance        = $db->leap_attendance;
$leap_tests             = $db->leap_tests;
$leap_test_results      = $db->leap_test_results;
$leap_activity_registrations = $db->leap_activity_registrations;

// Cloudinary — only initialise when all credentials are present.
if (getenv('CLOUDINARY_CLOUD_NAME') && getenv('CLOUDINARY_API_KEY') && getenv('CLOUDINARY_API_SECRET')) {
    \Cloudinary\Configuration\Configuration::instance([
        'cloud' => [
            'cloud_name' => getenv('CLOUDINARY_CLOUD_NAME'),
            'api_key'    => getenv('CLOUDINARY_API_KEY'),
            'api_secret' => getenv('CLOUDINARY_API_SECRET'),
        ],
        'url' => ['secure' => true],
    ]);
}

function uploadToCloudinary($fileTmpPath, $folder = 'sgi', $resourceType = 'image', $publicId = null) {
    if (!getenv('CLOUDINARY_CLOUD_NAME') || !getenv('CLOUDINARY_API_KEY') || !getenv('CLOUDINARY_API_SECRET')) {
        $origName = '';
        foreach ($_FILES as $file) {
            if (isset($file['tmp_name']) && $file['tmp_name'] === $fileTmpPath) {
                $origName = $file['name'];
                break;
            }
            if (is_array($file['tmp_name'] ?? null)) {
                foreach ($file['tmp_name'] as $index => $tmpName) {
                    if ($tmpName === $fileTmpPath) {
                        $origName = $file['name'][$index];
                        break 2;
                    }
                }
            }
        }

        $extension = strtolower(pathinfo($origName, PATHINFO_EXTENSION)) ?: 'bin';
        $filename = uniqid('sgi_', true) . '.' . $extension;
        $uploadDirectory = __DIR__ . '/uploads';
        if (!is_dir($uploadDirectory)) {
            mkdir($uploadDirectory, 0755, true);
        }
        move_uploaded_file($fileTmpPath, $uploadDirectory . '/' . $filename);
        return 'uploads/' . $filename;
    }

    $uploader = new \Cloudinary\Api\Upload\UploadApi();
    $uploadOptions = ['folder' => $folder, 'resource_type' => $resourceType];
    if ($publicId !== null) {
        $uploadOptions['public_id'] = $publicId;
    }
    $result = $uploader->upload($fileTmpPath, $uploadOptions);
    return $result['secure_url'];
}

// Session timeout — 30 minutes for web browsers, but extended for SGI Mobile App so notifications stay active.
$isMobileApp = (isset($_SERVER['HTTP_USER_AGENT']) && strpos($_SERVER['HTTP_USER_AGENT'], 'SGI-Android-App') !== false);
if (!$isMobileApp) {
    if (isset($_SESSION['user'])) {
        if (isset($_SESSION['last_activity']) && (time() - $_SESSION['last_activity'] > 1800)) {
            session_destroy();
            header('Location: index.php?timeout=1');
            exit;
        }
        $_SESSION['last_activity'] = time();
    }
} else {
    // Keep mobile app session persistent
    if (isset($_SESSION['user'])) {
        $_SESSION['last_activity'] = time();
    }
}

function imgUrl($path) {
    if (empty($path)) {
        return '';
    }
    if (strpos($path, 'http') === 0) {
        if (strpos($path, '/raw/upload/') !== false) {
            return str_replace('/raw/upload/', '/raw/upload/fl_attachment:false/', $path);
        }
        return $path;
    }
    return 'uploads/' . $path;
}

function requireLogin() {
    if (!isset($_SESSION['user'])) {
        header('Location: index.php');
        exit;
    }
}
